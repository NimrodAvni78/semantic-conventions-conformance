{
  "name": "open-telemetry-conformance/http-php-guzzle-obi",
  "description": "Guzzle HTTP client conformance with no OpenTelemetry in the process, measured through OBI.",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^8.0",
    "open-telemetry-conformance/http-test-client": "dev-main",
    "open-telemetry-conformance/scenario": "dev-main"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../../../../tools/http/test-client/php",
      "options": {
        "symlink": false,
        "versions": {
          "open-telemetry-conformance/http-test-client": "dev-main"
        }
      }
    },
    {
      "type": "path",
      "url": "../../../../../tools/php/scenario",
      "options": {
        "symlink": false,
        "versions": {
          "open-telemetry-conformance/scenario": "dev-main"
        }
      }
    }
  ]
}
